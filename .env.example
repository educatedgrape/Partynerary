# Atlas sandbox credentials — never commit real values.
ATLAS_BASE_URL=https://sandbox.atriptech.com
ATLAS_CLIENT_ID=your_client_id_here
ATLAS_CLIENT_SECRET=your_client_secret_here

# Set LIVE=1 to allow real HTTP calls. Without it, AtlasClient blocks live
# calls as a safety measure. The dashboard sets LIVE=1 automatically.
# LIVE=1

# Test card values — never commit real card data.
# ATLAS_TEST_CARD_NUMBER=
# ATLAS_TEST_CARD_CVV=
# ATLAS_TEST_CARD_EXPIRY=
